{
  "name": "Will I have signal out there",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.16.4"
    }
  },
  "postCreateCommand": "python -m pip install -e \".[dev]\" && cd app && npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "hashicorp.terraform",
        "ms-python.python"
      ]
    }
  }
}
